
# 配置默认配置路径
export ZDOTDIR=$HOME/.config/zsh

# 配置默认编辑器, nvim > vim >vi
if (( $+commands[nvim] )); then
  export EDITOR=nvim
elif (( $+commands[vim] )); then
  export EDITOR=vim
else
  export EDITOR=vi
fi
export VISUAL=$EDITOR

# uv 管理的 Python 工具链(Linux/macOS 通用,~/.local/bin 放 python/uv 等 shim)
export PATH="$HOME/.local/bin:$PATH"
